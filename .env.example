# RecoverIQ Environment Configuration
# Razorpay Test Mode Credentials
# Leave blank or unconfigured to run automatically in DEMO / SIMULATION MODE
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Settings
DATABASE_URL=sqlite:///./recoveriq.db

# Optional AI Provider (Domain Heuristic Rule Engine engages automatically when unset)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
