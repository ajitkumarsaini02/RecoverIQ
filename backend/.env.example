# RecoverIQ Environment Configuration
# Razorpay Test Mode Credentials
# Leave blank to run automatically in DEMO / SIMULATION MODE
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Settings
DATABASE_URL=sqlite:///./recoveriq.db

# AI Provider Settings (Optional - fallback rule engine activates automatically if unset)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
