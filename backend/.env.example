# RecoverIQ Backend Environment Configuration Template
# (Do NOT commit real secret keys to source control)

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI Provider Settings
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=

# Application & Networking
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://recover-iq-three.vercel.app
FRONTEND_URL=https://recover-iq-three.vercel.app

# Database Configuration
# Local SQLite (default):
DATABASE_URL=sqlite:///./recoveriq.db
# Production PostgreSQL (e.g. Render / Supabase / AWS RDS):
# DATABASE_URL=postgresql://user:password@host:5432/recoveriq_prod
