# RecoverIQ Backend Environment Configuration Template
# Razorpay Test Mode Credentials (Optional: simulation mode engages when unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Application Settings
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
FRONTEND_URL=https://your-app.vercel.app

# Database Settings
DATABASE_URL=sqlite:///./recoveriq.db

# AI Provider Settings (Optional: domain heuristics engine activates automatically if unset)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

